<?xml version="1.0" encoding="utf-8"?>
<!--
    widget_focus_medium.xml
    4×2 home screen widget for Ontime.

    IMPORTANT: This layout uses RemoteViews — NOT Compose.
    Only a limited set of Views are supported in widgets.
    Supported: LinearLayout, FrameLayout, RelativeLayout,
               TextView, ImageView, ProgressBar, Button.
    NOT supported: ConstraintLayout, RecyclerView, custom views.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="16dp">

    <!-- ── Row 1: App name + streak ──────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⏰ Ontime"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/widget_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Start your streak"
            android:textColor="#FFF59E0B"
            android:textSize="10sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- ── Row 2: Today's focus time (big number) ─────────────────────────── -->
    <TextView
        android:id="@+id/widget_time"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="0m"
        android:textColor="#FFFFFFFF"
        android:textSize="38sp"
        android:textStyle="bold"
        android:gravity="center"
        android:fontFamily="sans-serif-black" />

    <!-- ── Row 3: Progress bar + session count ───────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <ProgressBar
            android:id="@+id/widget_progress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_weight="1"
            android:progressDrawable="@drawable/widget_progress_drawable"
            android:max="100"
            android:progress="0" />

        <TextView
            android:id="@+id/widget_sessions_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 / 4 sessions"
            android:textColor="#FF94A3B8"
            android:textSize="10sp"
            android:layout_marginStart="8dp" />

    </LinearLayout>

    <!-- ── Row 4: Start focus button ─────────────────────────────────────── -->
    <TextView
        android:id="@+id/widget_start_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="▶  Start Focus Session"
        android:textColor="#FF7C3AED"
        android:textSize="12sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="@drawable/widget_btn_background"
        android:paddingTop="8dp"
        android:paddingBottom="8dp" />

</LinearLayout>
